{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["dom", "es2022"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment",
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": false
  },
  "include": ["src"]
}
